NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL — generate at fly.io or run locally
DATABASE_URL=postgresql://oakstone:password@localhost:5432/oakstone_bank

# Redis
REDIS_URL=redis://localhost:6379

# JWT — run this to generate: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX
